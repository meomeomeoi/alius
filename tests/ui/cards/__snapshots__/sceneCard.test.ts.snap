// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`her cards in her voice (look: scene) > the PDA thread is unchanged: without a look the task card is today's article.alius-voice 1`] = `"<article class="alius-voice alius-voice-personal alius-task" data-voice="personal" style="--voice-accent: #ffb86b;" data-task="pt1" data-task-form="button_cost" role="group" aria-label="Ann asks something of the commander" data-analyze="glossary:task_card" data-analyze-ctx="{&quot;unitId&quot;:&quot;unit_ann&quot;}" tabindex="0"><header class="alius-voice-head"><span class="alius-voice-from">Ann</span></header><div class="alius-voice-body"><div class="alius-task-body"><p class="alius-task-text">Bring me the patrol roster before evening mess.</p><p class="alius-task-due" data-analyze="glossary:practice_task" data-analyze-ctx="{&quot;unitId&quot;:&quot;unit_ann&quot;}" tabindex="0">Due: today, evening.</p><ul class="alius-task-cost" aria-label="What it costs" data-analyze="glossary:consent_ladder" data-analyze-ctx="{&quot;unitId&quot;:&quot;unit_ann&quot;}" tabindex="0"><li>Takes 1 slot of the commander's time.</li></ul><div class="alius-task-answers"><button type="button" class="alius-btn alius-tagchip" data-task-answer="accept" data-task="pt1" data-analyze="glossary:consent_ladder" data-analyze-ctx="{&quot;unitId&quot;:&quot;unit_ann&quot;}">[ ACCEPT ]</button><button type="button" class="alius-btn alius-tagchip" data-task-answer="refuse" data-task="pt1" data-analyze="glossary:practice_task" data-analyze-ctx="{&quot;unitId&quot;:&quot;unit_ann&quot;}">[ REFUSE ]</button><button type="button" class="alius-btn alius-tagchip" data-task-answer="talk" data-task="pt1" data-analyze="glossary:practice_task" data-analyze-ctx="{&quot;unitId&quot;:&quot;unit_ann&quot;}">[ TALK ]</button></div></div></div></article>"`;

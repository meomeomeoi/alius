  "differences": [
    {
      "fn": "gistOf",
      "reason": "The deadline is the card's own (`c.when`, the engine's deadline in `cardWhen`'s words), not the prototype's panel (`S.when`); a task with no deadline shows no `· when` (the prototype's every button task had one).",
      "diff": "@@ -2,3 +2,3 @@\n switch(c.kind){\n-case\"task\":return c.hold?`${c.summary}`:`${c.summary}${c.form===\"button\"?` · <b>${S.when}</b>`:\"\"}`\n+case\"task\":return c.hold?`${c.summary}`:`${c.summary}${c.form===\"button\"&&c.when?` · <b>${c.when}</b>`:\"\"}`\n case\"sealed\":return\"✉\""
    },
    {
      "fn": "fill",
      "reason": "Task 3 (R7): her line is runs (`{ text, value? }`) that the card draws as text nodes and `span.alius-scard-v`, never an HTML string; the rule is the prototype's (`{x}` as it is, `{X}` capitalised, a value not given stays as written).",
      "diff": "@@ -1,11 +1,24 @@\n function fill(frame,vals){\n-const esc=t=>String(t).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);\n-  return esc(frame).replace(/\\{\n-(\\w+)\\\n+const runs=[]\n+const plain=t=>{\n+if(t===\"\")return\n+const last=runs[runs.length-1]\n+if(last!==undefined&&last.value===undefined)last.text+=t\n+else runs.push({\n+text:t\n+})\n }\n-/g, (_, k) => {\n-    const v = vals[k.toLowerCase()];\n-    if (v === undefined) return `{${k}}`;\n-    return `<span class=\"v\">${esc(k[0] === k[0].toUpperCase() ? cap(v) : v)}</span>`;\n-  });\n+const at=0\n+for(const m of frame.matchAll(/\\{(\\w+)\\}/g)) {\n+        const k = m[1];\n+        plain(frame.slice(at, m.index));\n+        at = m.index + m[0].length;\n+        const v = vals[k.toLowerCase()];\n+        if (v === undefined)\n+            plain(`{${k}}`);\n+        else\n+            runs.push({ text: k[0] === k[0].toUpperCase() ? cap(v) : v, value: true });\n+    }\n+    plain(frame.slice(at));\n+    return runs;\n }"
    },
    {
      "fn": "linesOf",
      "reason": "Task 3 (R7): the lines are the `cardVoice` registry read by kind and style (her style's row, else the neutral row), not the prototype's NEUTRAL / STYLE objects; a kind with no rows has none.",
      "diff": "@@ -1,5 +1,4 @@\n-function linesOf(kind){\n-const path=kind.split(\".\")\n-const get=o=>path.reduce((a,k)=>(a==null?a:a[k]),o)\n-return get(STYLE[S.style]??{})??get(NEUTRAL)\n+function linesOf(reg,kind,style){\n+const idx=indexOf(reg.cardVoice)\n+return(style!==undefined?idx.get(`${kind}|${style}`):undefined)??idx.get(`${kind}|`)??[]\n }"
    },
    {
      "fn": "pick",
      "reason": "Task 3 (R7): `voiceLine` is `pick` and `fill` in one: the registry's lines, her style passed in (the prototype reads `S.style`), the card's key; the hash is the prototype's (`fnv1a(key|style|kind) % n`, `neutral` for a holder with no style).",
      "diff": "@@ -1,4 +1,5 @@\n-function pick(cardId,kind){\n-const list=linesOf(kind)\n-return list[fnv1a(`${cardId}|${S.style}|${kind}`)%list.length]\n+function pick(reg,kind,style,key,vals){\n+const list=linesOf(reg,kind,style)\n+if(list.length===0)return[]\n+return fill(list[fnv1a(`${key}|${style??\"neutral\"}|${kind}`)%list.length],vals)\n }"
    }
